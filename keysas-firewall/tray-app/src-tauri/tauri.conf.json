{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keysas-tray-app",
  "version": "0.1.0",
  "identifier": "com.keysas.usbfirewall",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Keysas USB Firewall",
        "url": "index.html",
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/logo-keysas-short.ico",
      "icons/logo-keysas-short-16.png",
      "icons/logo-keysas-short-32.png",
      "icons/logo-keysas-short-48.png",
      "icons/logo-keysas-short-256.png"
    ],
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0"],
        "files": {
          "/etc/xdg/autostart/keysas-tray-app.desktop": "keysas-tray-app-autostart.desktop"
        }
      }
    },
    "windows": {
      "wix": {
        "language": ["fr-FR", "en-US"]
      }
    }
  }
}
