#!/bin/sh
set -e

CONF_DIR=/etc/keysas/firewall

case "$1" in
    configure)
        # Créer le répertoire des certificats avec les bons droits
        install -d -m 750 "$CONF_DIR"

        # Monter le BPF filesystem si absent
        if ! mountpoint -q /sys/fs/bpf 2>/dev/null; then
            mount -t bpf bpf /sys/fs/bpf || true
        fi

        # Ajouter l'entrée fstab si absente
        if ! grep -qs '/sys/fs/bpf' /etc/fstab; then
            echo 'bpf /sys/fs/bpf bpf defaults 0 0' >> /etc/fstab
        fi

        # Recharger systemd
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload || true
        fi

        echo ""
        echo "┌─────────────────────────────────────────────────────────┐"
        echo "│  keysas-firewall installé                               │"
        echo "│                                                         │"
        echo "│  Avant de démarrer le service, déposez les certificats  │"
        echo "│  CA dans /etc/keysas/firewall/ :                        │"
        echo "│    st-ca-cl.pem   st-ca-pq.pem                         │"
        echo "│    usb-ca-cl.pem  usb-ca-pq.pem                        │"
        echo "│                                                         │"
        echo "│  Puis activez le service :                              │"
        echo "│    systemctl enable --now keysas-firewall               │"
        echo "└─────────────────────────────────────────────────────────┘"
        echo ""
        ;;
esac

#DEBHELPER#
exit 0
