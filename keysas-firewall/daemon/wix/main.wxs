<?xml version='1.0' encoding='windows-1252'?>
<!--
  Keysas Firewall — WiX v3 installer source
  Build (Linux/Docker via wixl):
    wixl -D Version=x.y.z -D BinDir=... -D MinifilterDir=... -D TrayAppBinDir=... -a x64 wix/main.wxs

  $(var.MinifilterDir) must contain:
    KeysasMinifilter.sys   — compiled with WDK on Windows
    KeysasMinifilter.cat   — catalog file (test-signed or production-signed)
  The .inf is read directly from the source tree (no WDK needed).

  NOTE: loading a kernel driver on Windows 11 requires either:
    - a production EV code-signing certificate, or
    - test-signing mode: bcdedit /set testsigning on  (+ reboot)
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi' xmlns:ui='http://schemas.microsoft.com/wix/2006/ui'>

  <Product
    Id='*'
    Name='Keysas USB Firewall'
    UpgradeCode='37C429B0-B7F9-47C6-B840-D55BD5024EE8'
    Manufacturer='Association Cocktail'
    Language='1033'
    Codepage='1252'
    Version='$(var.Version)'>

    <Package
      Id='*'
      Keywords='Installer'
      Description='Keysas USB Firewall — minifilter driver + daemon service'
      Manufacturer='Association Cocktail'
      InstallerVersion='450'
      Languages='1033'
      Compressed='yes'
      SummaryCodepage='1252'
      />

    <!-- Refuse downgrades; silently upgrade same-or-older installations -->
    <MajorUpgrade
      DowngradeErrorMessage='A newer version of [ProductName] is already installed.'/>

    <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
    <Property Id='DiskPrompt' Value='Keysas USB Firewall Installation'/>

    <Property Id='MSIUSEREALADMINDETECTION' Value='1'/>

    <!--
      Policy properties — default to 0 (most restrictive).
      Override at install time via command line for silent/automated deployments:
        msiexec /i keysas-firewall.msi /quiet DISABLE_UNSIGNED_USB=1
        msiexec /i keysas-firewall.msi /quiet ALLOW_USER_USB_AUTH=1 ALLOW_USER_FILE_READ=1
      All four can be changed after install by re-running msiexec with new values.
    -->
    <!--
      Policy properties — defaults to 0 (most restrictive).
      These are used only as the CheckBox-bound properties in the UI wizard.
      Registry writes are handled by per-feature components (feat_policy_*)
      via the MSI Feature Level mechanism, which transmits state from the
      UI sequence to the elevated Execute sequence reliably on Windows 11,
      independently of SecureCustomProperties.
      Secure='yes' is kept so that property values are also transmitted via
      SecureCustomProperties as a belt-and-suspenders measure on platforms
      where that mechanism works.
    -->
    <Property Id='DISABLE_UNSIGNED_USB'  Value='0' Secure='yes'/>
    <Property Id='ALLOW_USER_USB_AUTH'   Value='0' Secure='yes'/>
    <Property Id='ALLOW_USER_FILE_READ'  Value='0' Secure='yes'/>
    <Property Id='ALLOW_USER_FILE_WRITE' Value='0' Secure='yes'/>
    <!--
      Helper properties for SetFeatureLevel: hold the target level (1=install, 2=absent).
      Initialized to '2' so that unchecked = absent (re-installable), not disabled (level=0).
      Level=0 would permanently disable the hidden feature and crash on re-check.
    -->
    <Property Id='_DISABLE_USB_LVL'  Value='2'/>
    <Property Id='_USB_AUTH_LVL'     Value='2'/>
    <Property Id='_FILE_READ_LVL'    Value='2'/>
    <Property Id='_FILE_WRITE_LVL'   Value='2'/>

    <!-- ───────────────────────────────────────────────── directory tree -->
    <Directory Id='TARGETDIR' Name='SourceDir'>

      <!-- ── Daemon binary: C:\Program Files\Keysas Firewall\ ── -->
      <Directory Id='ProgramFiles64Folder'>
        <Directory Id='APPLICATIONFOLDER' Name='Keysas Firewall'>

          <!--
            Tray application: launched at user login via HKLM Run key.
            Must be installed before starting the daemon so the mailslot
            server (SERVICE_PIPE) is available.
          -->
          <!-- Per-machine component: tray-app executable in Program Files -->
          <Component Id='comp_trayapp' Guid='C8D5E392-F4A1-4B7E-A263-8F2B9D0E4C15' Win64='yes'>
            <File
              Id='exe_trayapp'
              Name='keysas-usbfilter-trayapp.exe'
              DiskId='1'
              Source='$(var.TrayAppBinDir)/keysas-usbfilter-trayapp.exe'
              KeyPath='yes'/>
            <!--
              RemoveFolder tells MSI to delete APPLICATIONFOLDER on uninstall
              when empty. Remaining files are handled by the OS after reboot.
            -->
            <RemoveFolder Id='rm_appfolder' Directory='APPLICATIONFOLDER' On='uninstall'/>
          </Component>

          <!--
            Per-machine Run key: launches the tray-app at logon for all users.
            Using HKLM (not HKCU) ensures that uninstall — which runs as SYSTEM
            and therefore has a different HKCU hive — can clean up this entry.
            ICE57 requires the File and the Run key to remain in separate
            components because File uses Win64='yes' KeyPath while the registry
            value is the KeyPath here.
          -->
          <Component Id='comp_trayapp_run' Guid='B4E2A917-D3C5-4F8B-A7E1-2D9C0F6B3A74' Win64='yes'>
            <RegistryValue
              Root='HKLM'
              Key='SOFTWARE\Microsoft\Windows\CurrentVersion\Run'
              Name='KeysasFirewallTray'
              Type='string'
              Value='"[APPLICATIONFOLDER]keysas-usbfilter-trayapp.exe"'
              KeyPath='yes'/>
          </Component>

          <!--
            Daemon executable + Windows Service registration.
            The service depends on KeysasMinifilter: SCM will start the
            driver automatically before starting the daemon.
          -->
          <Component Id='comp_binary' Guid='02B83024-9E87-4AFA-B324-11BB64B3D686' Win64='yes'>
            <File
              Id='exe_daemon'
              Name='keysas-usbfilter-daemon.exe'
              DiskId='1'
              Source='$(var.BinDir)/keysas-usbfilter-daemon.exe'
              KeyPath='yes'/>

            <ServiceInstall
              Id='svc_install'
              Type='ownProcess'
              Name='Keysas Service'
              DisplayName='Keysas USB Firewall'
              Description='Verifies USB key certificates and blocks uncertified devices.'
              Start='auto'
              Account='LocalSystem'
              ErrorControl='normal'>
              <!-- Daemon must not start before the minifilter is running -->
              <ServiceDependency Id='KeysasMinifilter'/>
            </ServiceInstall>

            <ServiceControl
              Id='svc_control'
              Name='Keysas Service'
              Stop='both'
              Remove='uninstall'
              Wait='yes'/>
          </Component>

          <!--
            Certificate paths — always written regardless of policy choices.
            Policy DWORD values (DisableUnsignedUsb, AllowUser*) are written
            by the four feat_policy_* sub-feature components below, which use
            the MSI Feature Level mechanism for reliable UI→Execute transmission.
            When a feature is absent (box unchecked), no DWORD is written and
            the daemon treats the missing value as 0 (most restrictive default).
          -->
          <Component Id='comp_registry' Guid='BFC665F7-039E-4513-902E-5C436657252C' Win64='yes'>
            <RegistryKey
              Root='HKLM'
              Key='SYSTEM\CurrentControlSet\Services\Keysas Service\config'>
              <RegistryValue Type='string'  Name='StCaClCert'  KeyPath='yes'
                Value='C:\ProgramData\Keysas\Firewall\st-ca-cl.pem'/>
              <RegistryValue Type='string'  Name='StCaPqCert'
                Value='C:\ProgramData\Keysas\Firewall\st-ca-pq.pem'/>
              <RegistryValue Type='string'  Name='UsbCaClCert'
                Value='C:\ProgramData\Keysas\Firewall\usb-cl.pem'/>
              <RegistryValue Type='string'  Name='UsbCaPqCert'
                Value='C:\ProgramData\Keysas\Firewall\usb-pq.pem'/>
            </RegistryKey>
            <!--
              RemoveRegistryValues runs BEFORE WriteRegistryValues in the MSI sequence.
              These entries erase any stale policy DWORDs left by a previous install or
              manual reg add before the feat_policy_* components write the fresh values.
              Return is silent if a value does not exist (MSI ignores missing keys here).
            -->
            <RemoveRegistryValue Root='HKLM'
              Key='SYSTEM\CurrentControlSet\Services\Keysas Service\config'
              Name='DisableUnsignedUsb'/>
            <RemoveRegistryValue Root='HKLM'
              Key='SYSTEM\CurrentControlSet\Services\Keysas Service\config'
              Name='AllowUserUsbAuthorization'/>
            <RemoveRegistryValue Root='HKLM'
              Key='SYSTEM\CurrentControlSet\Services\Keysas Service\config'
              Name='AllowUserFileRead'/>
            <RemoveRegistryValue Root='HKLM'
              Key='SYSTEM\CurrentControlSet\Services\Keysas Service\config'
              Name='AllowUserFileWrite'/>
          </Component>

          <!--
            Policy DWORD components — one per checkbox option.
            Each component writes the corresponding DWORD value = 1.
            They are installed only when the user checks the corresponding box
            (the feature level is raised to 1 by the SetFeatureLevel dialog event).
            When absent (feature level 2 > INSTALLLEVEL 1), the DWORD is not
            written; the daemon treats the missing key as 0.
            On upgrade, an absent feature removes a previously written DWORD,
            so unchecking a box during reinstall correctly reverts to 0.
          -->
          <Component Id='comp_policy_disable_usb' Guid='A3D7F089-C152-4B6E-8D4F-2E9A73B1C0F5' Win64='yes'>
            <RegistryValue Root='HKLM'
              Key='SYSTEM\CurrentControlSet\Services\Keysas Service\config'
              Name='DisableUnsignedUsb' Type='integer' Value='1' KeyPath='yes'/>
          </Component>

          <Component Id='comp_policy_usb_auth' Guid='F5C8B2A4-7D91-4E38-A5C3-9B3D0E8F2A5C' Win64='yes'>
            <RegistryValue Root='HKLM'
              Key='SYSTEM\CurrentControlSet\Services\Keysas Service\config'
              Name='AllowUserUsbAuthorization' Type='integer' Value='1' KeyPath='yes'/>
          </Component>

          <Component Id='comp_policy_file_read' Guid='2BE1F7A3-9C54-4D82-B6E1-3A8D2C9F6B3E' Win64='yes'>
            <RegistryValue Root='HKLM'
              Key='SYSTEM\CurrentControlSet\Services\Keysas Service\config'
              Name='AllowUserFileRead' Type='integer' Value='1' KeyPath='yes'/>
          </Component>

          <Component Id='comp_policy_file_write' Guid='7C4E9F62-A3B5-4D08-9F2E-6B0A3D8C5E1D' Win64='yes'>
            <RegistryValue Root='HKLM'
              Key='SYSTEM\CurrentControlSet\Services\Keysas Service\config'
              Name='AllowUserFileWrite' Type='integer' Value='1' KeyPath='yes'/>
          </Component>

          <!--
            Minifilter instance registry keys.
            These replicate the [MiniFilter.AddRegistry] section of the INF:
            altitude, flags, SupportedFeatures, DebugFlags.
            They are placed here (under APPLICATIONFOLDER) because WiX
            requires every Component to live inside a Directory element.
          -->
          <Component Id='comp_minifilter_reg' Guid='E2B4F076-A1C3-4E8D-B5F9-2C7D3E8F1A06' Win64='yes'>
            <!--
              WiX 3.x ServiceInstall only supports ownProcess / shareProcess —
              file-system driver type (0x2) cannot be expressed via that element.
              We write the service registration directly into the registry instead.
              ServiceControl (in comp_minifilter_sys) still handles stop / remove
              via the MSI ServiceControl table, which works independently of how
              the service was created.
            -->
            <RegistryKey Root='HKLM' Key='SYSTEM\CurrentControlSet\Services\KeysasMinifilter'>
              <!-- Service registration.
                   ImagePath MUST use the NT namespace path \SystemRoot\... (not the
                   Win32 %SystemRoot% env-var form).  NtLoadDriver() expects an NT
                   path; passing a Win32 path causes ERROR_PATH_NOT_FOUND even when
                   the .sys file is physically present in System32\drivers\.
                   This matches what SetupAPI writes when installing via INF (%12%). -->
              <RegistryValue Type='string' Name='ImagePath'
                Value='\SystemRoot\System32\drivers\KeysasMinifilter.sys'/>
              <RegistryValue Type='string'  Name='DisplayName'   Value='Keysas Mini-Filter Driver'/>
              <RegistryValue Type='string'  Name='Description'   Value='Keysas Mini-Filter Driver'/>
              <RegistryValue Type='integer' Name='Type'          Value='2'/>  <!-- SERVICE_FILE_SYSTEM_DRIVER -->
              <RegistryValue Type='integer' Name='Start'         Value='3'/>  <!-- SERVICE_DEMAND_START -->
              <RegistryValue Type='integer' Name='ErrorControl'  Value='1'/>  <!-- SERVICE_ERROR_NORMAL -->
              <RegistryValue Type='string'  Name='Group'         Value='FSFilter Activity Monitor'/>
              <RegistryValue Type='multiString' Name='DependOnService' Value='FltMgr[~]'/>
              <!-- Filter-manager-specific values -->
              <RegistryValue Type='integer' Name='DebugFlags'        Value='0'/>
              <RegistryValue Type='integer' Name='SupportedFeatures' Value='3'
                KeyPath='yes'/>
            </RegistryKey>
            <RegistryKey Root='HKLM'
              Key='SYSTEM\CurrentControlSet\Services\KeysasMinifilter\Instances'>
              <RegistryValue Type='string' Name='DefaultInstance' Value='Keysas Instance'/>
            </RegistryKey>
            <RegistryKey Root='HKLM'
              Key='SYSTEM\CurrentControlSet\Services\KeysasMinifilter\Instances\Keysas Instance'>
              <RegistryValue Type='string'  Name='Altitude' Value='370033'/>
              <RegistryValue Type='integer' Name='Flags'    Value='0'/>
            </RegistryKey>
          </Component>

        </Directory>
      </Directory>

      <!--
        ── Minifilter driver binary: %SystemRoot%\System32\drivers\ ──
        System64Folder always resolves to %SystemRoot%\System32 on x64.
        Service registration is done via registry in comp_minifilter_reg
        (WiX 3.x ServiceInstall only supports ownProcess/shareProcess, not
        SERVICE_FILE_SYSTEM_DRIVER = 0x2).  ServiceControl below handles
        stop/start/remove via the MSI ServiceControl table, which works
        independently of how the service was created.
      -->
      <Directory Id='System64Folder'>
        <Directory Id='DriversDirSys' Name='drivers'>
          <Component Id='comp_minifilter_sys' Guid='F3A7E891-B2C4-4D1E-9A3F-7B8C2D5E6F90' Win64='yes'>
            <File
              Id='file_minifilter_sys'
              Name='KeysasMinifilter.sys'
              DiskId='1'
              Source='$(var.MinifilterDir)/KeysasMinifilter.sys'
              KeyPath='yes'/>

            <!--
              Catalog file for driver signature verification.
              Required for Windows 11 (PnpLockdown=1 in the INF).
            -->
            <File
              Id='file_minifilter_cat'
              Name='KeysasMinifilter.cat'
              DiskId='1'
              Source='$(var.MinifilterDir)/KeysasMinifilter.cat'/>

            <!--
              Do NOT start the minifilter at install time: the driver requires
              either test-signing mode (dev/test) or a proper EV + attestation
              signature (production).  Starting here would cause an immediate
              rollback if signing is not trusted.  The service starts on next
              boot (Start=3 / SERVICE_DEMAND_START, triggered by SCM).
            -->
            <ServiceControl
              Id='svc_minifilter_control'
              Name='KeysasMinifilter'
              Stop='both'
              Remove='uninstall'
              Wait='no'/>
          </Component>
        </Directory>
      </Directory>

      <!-- Certificate directory: C:\ProgramData\Keysas\Firewall\ -->
      <Directory Id='CommonAppDataFolder'>
        <Directory Id='KEYSASDATADIR' Name='Keysas'>
          <Directory Id='CERTFOLDER' Name='Firewall'>
            <Component Id='comp_certdir' Guid='7287E597-B0DC-41B4-A3FF-44117C03CCCD' Win64='yes'>
              <CreateFolder/>
              <RemoveFolder Id='rm_certdir' On='uninstall'/>
              <RegistryValue
                Root='HKLM'
                Key='SOFTWARE\Keysas\Firewall'
                Name='CertDir'
                Type='string'
                Value='[CERTFOLDER]'
                KeyPath='yes'/>
            </Component>
          </Directory>
        </Directory>
      </Directory>

    </Directory>
    <!-- ──────────────────────────────────────────────────── features -->

    <Feature Id='Complete' Title='Keysas USB Firewall' Level='1'>
      <ComponentRef Id='comp_trayapp'/>
      <ComponentRef Id='comp_trayapp_run'/>
      <ComponentRef Id='comp_binary'/>
      <ComponentRef Id='comp_registry'/>
      <ComponentRef Id='comp_certdir'/>
      <ComponentRef Id='comp_minifilter_sys'/>
      <ComponentRef Id='comp_minifilter_reg'/>

      <!--
        Policy sub-features — Level='2' means absent by default (INSTALLLEVEL=1 < 2).
        SetFeatureLevel events in PolicySettingsDlg raise the level to 1 (install)
        when the user checks the corresponding box, and back to 2 (absent) when
        unchecked.  Feature state transmission from UI to elevated Execute sequence
        is handled by MSI internally and does not depend on SecureCustomProperties.
        Display='hidden' hides these from any feature-selection UI.
      -->
      <Feature Id='feat_policy_disable_usb'  Level='2' Display='hidden'>
        <ComponentRef Id='comp_policy_disable_usb'/>
      </Feature>
      <Feature Id='feat_policy_usb_auth'     Level='2' Display='hidden'>
        <ComponentRef Id='comp_policy_usb_auth'/>
      </Feature>
      <Feature Id='feat_policy_file_read'    Level='2' Display='hidden'>
        <ComponentRef Id='comp_policy_file_read'/>
      </Feature>
      <Feature Id='feat_policy_file_write'   Level='2' Display='hidden'>
        <ComponentRef Id='comp_policy_file_write'/>
      </Feature>
    </Feature>

    <!-- ──────────────────────────────────────────── force-stop before remove -->
    <!--
      CA_KillTrayApp      : kill the tray-app process (user session, Run key)
                            before StopServices tries to delete its locked EXE.
      CA_UnloadMinifilter : unload the minifilter via fltMC before RemoveFiles;
                            without this, KeysasMinifilter.sys stays locked in
                            memory and its deletion fails.
      Both actions use Execute='deferred' + Impersonate='no' to run as SYSTEM.
      Return='ignore' prevents the uninstall from aborting if the process or
      driver is already gone.
      The existing ServiceControl elements (Wait='yes' on the daemon,
      Wait='no' on the minifilter) handle clean service stop via the SCM.
    -->
    <!--
      Kill the daemon process before StopServices.
      The daemon service does not honour the SCM Stop signal (the service
      event handler sets stop_signal but the service worker thread may take
      up to 1 s to notice).  Taskkill /F forces the process to exit
      immediately, releasing all open handles (minifilter device handle,
      locked EXE file) so that StopServices, DeleteServices, and RemoveFiles
      can complete cleanly.
    -->
    <CustomAction Id='CA_KillDaemon'
      Directory='TARGETDIR'
      ExeCommand='[System64Folder]taskkill.exe /F /IM keysas-usbfilter-daemon.exe /T'
      Execute='deferred'
      Impersonate='no'
      Return='ignore'/>

    <!--
      Kill the tray-app and all its child processes (/T) including any
      WebView2 (msedgewebview2.exe) sub-processes that Tauri spawns.
      Two separate calls: one by image name, one by window title, so that
      even if the binary was renamed the process is terminated.
    -->
    <CustomAction Id='CA_KillTrayApp'
      Directory='TARGETDIR'
      ExeCommand='[System64Folder]taskkill.exe /F /IM keysas-usbfilter-trayapp.exe /T'
      Execute='deferred'
      Impersonate='no'
      Return='ignore'/>

    <!--
      Kill any surviving WebView2 renderer/broker processes.
      CA_KillTrayApp /T already terminates the tray-app and its process tree,
      but WebView2 children can outlive their parent for a short window.
      Killing all msedgewebview2.exe instances here is intentional: they are
      stateless renderer processes that restart automatically, so briefly
      terminating them on a security-product uninstall is acceptable.
    -->
    <CustomAction Id='CA_KillWebView2'
      Directory='TARGETDIR'
      ExeCommand='[System64Folder]taskkill.exe /F /IM msedgewebview2.exe'
      Execute='deferred'
      Impersonate='no'
      Return='ignore'/>

    <!--
      Unload the minifilter kernel driver BEFORE StopServices so the daemon
      (which depends on KeysasMinifilter) can be stopped cleanly by the SCM.
      If the driver is still loaded when StopServices runs, the daemon stop
      may time out and DeleteServices may skip the daemon entry.
    -->
    <CustomAction Id='CA_UnloadMinifilter'
      Directory='TARGETDIR'
      ExeCommand='[System64Folder]fltMC.exe unload KeysasMinifilter'
      Execute='deferred'
      Impersonate='no'
      Return='ignore'/>

    <!--
      Fallback service deletion: if DeleteServices did not fully remove the
      service entries (e.g. because a stop timed out), sc.exe delete forces
      the removal from the registry.  Return='ignore' is safe — sc reports
      "service not found" when the entry is already gone.
    -->
    <CustomAction Id='CA_DeleteDaemonSvc'
      Directory='TARGETDIR'
      ExeCommand='[System64Folder]sc.exe delete "Keysas Service"'
      Execute='deferred'
      Impersonate='no'
      Return='ignore'/>

    <CustomAction Id='CA_DeleteMinifilterSvc'
      Directory='TARGETDIR'
      ExeCommand='[System64Folder]sc.exe delete KeysasMinifilter'
      Execute='deferred'
      Impersonate='no'
      Return='ignore'/>

    <!--
      Folder cleanup: RemoveFolder in comp_trayapp handles the directory
      removal. MSI's RemoveFiles step handles tracked files. Any remaining
      files (WebView2 cache, logs) are cleaned up by the OS after reboot.
    -->

    <!--
      Delete the Firewall registry key and its parent Keysas key.
      These are left empty after RemoveRegistryValues removes individual
      values, so we clean them up explicitly here.
    -->
    <CustomAction Id='CA_DeleteFirewallRegKey'
      Directory='TARGETDIR'
      ExeCommand='[System64Folder]reg.exe delete "HKLM\SOFTWARE\Keysas\Firewall" /f'
      Execute='deferred'
      Impersonate='no'
      Return='ignore'/>

    <CustomAction Id='CA_DeleteKeysasRegKey'
      Directory='TARGETDIR'
      ExeCommand='[System64Folder]reg.exe delete "HKLM\SOFTWARE\Keysas" /f'
      Execute='deferred'
      Impersonate='no'
      Return='ignore'/>

    <!-- ──────────────────────────────────────────────────── reboot -->
    <!--
      The minifilter driver service is registered via direct registry writes
      (WiX 3 ServiceInstall does not support Type=2 / SERVICE_FILE_SYSTEM_DRIVER).
      The SCM rebuilds its service database from the registry only at boot time,
      so a reboot is required for KeysasMinifilter to become visible to the SCM.
      ScheduleReboot prompts the user at the end of installation.
      For silent installs (/quiet) the reboot is deferred — caller must reboot.
    -->
    <InstallExecuteSequence>
      <!-- Folder cleanup handled by RemoveFolder element -->
      <!-- Force-kill daemon and tray-app BEFORE StopServices so that
           all file handles are released and the SCM can cleanly remove
           the services.  Daemon is killed first so the minifilter handle
           is freed before fltMC attempts the unload. -->
      <Custom Action='CA_KillDaemon'           Before='StopServices'>REMOVE="ALL"</Custom>
      <Custom Action='CA_KillTrayApp'          Before='StopServices'>REMOVE="ALL"</Custom>
      <Custom Action='CA_KillWebView2'         Before='StopServices'>REMOVE="ALL"</Custom>
      <Custom Action='CA_UnloadMinifilter'     Before='StopServices'>REMOVE="ALL"</Custom>
      <!-- Fallback: force-delete service registry entries that DeleteServices
           may have skipped if a stop timed out. -->
      <Custom Action='CA_DeleteDaemonSvc'      After='DeleteServices'>REMOVE="ALL"</Custom>
      <Custom Action='CA_DeleteMinifilterSvc'  After='DeleteServices'>REMOVE="ALL"</Custom>
      <!-- Clean up empty Firewall and Keysas registry keys. -->
      <Custom Action='CA_DeleteFirewallRegKey' After='DeleteServices'>REMOVE="ALL"</Custom>
      <Custom Action='CA_DeleteKeysasRegKey'   After='DeleteServices'>REMOVE="ALL"</Custom>
      <!-- No additional folder cleanup needed -->
      <ScheduleReboot After='InstallFinalize'/>
    </InstallExecuteSequence>

    <!-- ──────────────────────────────────────────────────── UI -->
    <!--
      GUI wizard: WelcomeDlg → PolicySettingsDlg → CertInfoDlg → install.
      Silent install (no dialogs):
        msiexec /i keysas-firewall.msi /quiet
      Policy overrides via command line:
        msiexec /i keysas-firewall.msi DISABLE_UNSIGNED_USB=1 ALLOW_USER_USB_AUTH=1
      WixUIExtension is auto-loaded by cargo-wix via the DialogRef elements below.
    -->
    <UI Id='WixUI_Keysas'>
      <TextStyle Id='WixUI_Font_Normal' FaceName='Tahoma' Size='8'/>
      <TextStyle Id='WixUI_Font_Bigger' FaceName='Tahoma' Size='12'/>
      <TextStyle Id='WixUI_Font_Title'  FaceName='Tahoma' Size='9' Bold='yes'/>

      <Property Id='DefaultUIFont' Value='WixUI_Font_Normal'/>
      <Property Id='WixUI_Mode'    Value='Minimal'/>

      <!-- Standard dialogs from WixUIExtension (auto-loaded by cargo-wix) -->
      <DialogRef Id='CancelDlg'/>
      <DialogRef Id='ErrorDlg'/>
      <DialogRef Id='FatalError'/>
      <DialogRef Id='FilesInUse'/>
      <DialogRef Id='MsiRMFilesInUse'/>
      <DialogRef Id='PrepareDlg'/>
      <DialogRef Id='ProgressDlg'/>
      <DialogRef Id='ResumeDlg'/>
      <DialogRef Id='UserExit'/>

      <!-- Step 1 — Welcome -->
      <Dialog Id='KeysasWelcomeDlg' Width='370' Height='270' Title='[ProductName] Setup'>
        <Control Id='Bitmap' Type='Bitmap' X='0' Y='0' Width='370' Height='234'
          TabSkip='yes' Text='WixUI_Bmp_Dialog'/>
        <Control Id='BottomLine' Type='Line' X='0' Y='234' Width='370' Height='0'/>
        <Control Id='Title' Type='Text' X='135' Y='20' Width='220' Height='60'
          Transparent='yes' NoPrefix='yes'>
          <Text>{\WixUI_Font_Bigger}Welcome to [ProductName] Setup</Text>
        </Control>
        <Control Id='Description' Type='Text' X='135' Y='80' Width='220' Height='60'
          Transparent='yes' NoPrefix='yes'>
          <Text>This wizard installs the Keysas USB Firewall (minifilter driver, daemon service, and tray application). Click Next to configure the security policy.</Text>
        </Control>
        <Control Id='Next' Type='PushButton' X='236' Y='243' Width='56' Height='17'
          Default='yes' Text='&amp;Next'>
          <Publish Event='NewDialog' Value='PolicySettingsDlg'>1</Publish>
        </Control>
        <Control Id='Back' Type='PushButton' X='180' Y='243' Width='56' Height='17'
          Disabled='yes' Text='&amp;Back'/>
        <Control Id='Cancel' Type='PushButton' X='304' Y='243' Width='56' Height='17'
          Cancel='yes' Text='Cancel'>
          <Publish Event='SpawnDialog' Value='CancelDlg'>1</Publish>
        </Control>
      </Dialog>

      <!-- Step 2 — Security policy checkboxes -->
      <Dialog Id='PolicySettingsDlg' Width='370' Height='270'
        Title='Security Policy — [ProductName]'>
        <Control Id='BannerBitmap' Type='Bitmap' X='0' Y='0' Width='370' Height='44'
          TabSkip='yes' Text='WixUI_Bmp_Banner'/>
        <Control Id='BannerLine' Type='Line' X='0' Y='44' Width='370' Height='0'/>
        <Control Id='BottomLine' Type='Line' X='0' Y='234' Width='370' Height='0'/>
        <Control Id='Title' Type='Text' X='15' Y='6' Width='200' Height='15'
          Transparent='yes' NoPrefix='yes'>
          <Text>{\WixUI_Font_Title}Security Policy</Text>
        </Control>
        <Control Id='Description' Type='Text' X='25' Y='23' Width='300' Height='15'
          Transparent='yes' NoPrefix='yes'>
          <Text>Configure the USB firewall security policy.</Text>
        </Control>
        <!--
          Each CheckBox is bound to a Property (for rendering state) AND
          publishes SetFeatureLevel events so that the corresponding policy
          sub-feature is installed (level 1) or removed (level 2) based on
          the user's choice.  Feature states are transmitted to the elevated
          Execute sequence by MSI's own mechanism, independently of
          SecureCustomProperties, which is unreliable on Windows 11.
        -->
        <!--
          WiX v3 SetFeatureLevel: Value = feature name, content = INTEGER level expression.
          3 Publish events per checkbox: first two set a helper property to 1 (install) or 2
          (absent/re-installable); the third passes [helper] as the level to SetFeatureLevel.
          Level=2 (absent) allows the feature to be re-enabled; level=0 (disabled) would
          permanently disable a hidden feature and crash on re-check.
        -->
        <Control Id='chk_disable_usb' Type='CheckBox'
          X='20' Y='58' Width='340' Height='17'
          Property='DISABLE_UNSIGNED_USB' CheckBoxValue='1'>
          <Text>&amp;Block uncertified USB keys (recommended)</Text>
          <Publish Property='_DISABLE_USB_LVL' Value='1'>DISABLE_UNSIGNED_USB = "1"</Publish>
          <Publish Property='_DISABLE_USB_LVL' Value='2'>NOT DISABLE_UNSIGNED_USB = "1"</Publish>
          <Publish Event='SetFeatureLevel' Value='feat_policy_disable_usb'>[_DISABLE_USB_LVL]</Publish>
        </Control>
        <Control Id='chk_user_usb_auth' Type='CheckBox'
          X='20' Y='80' Width='340' Height='17'
          Property='ALLOW_USER_USB_AUTH' CheckBoxValue='1'>
          <Text>Allow &amp;user to manually authorize blocked USB keys</Text>
          <Publish Property='_USB_AUTH_LVL' Value='1'>ALLOW_USER_USB_AUTH = "1"</Publish>
          <Publish Property='_USB_AUTH_LVL' Value='2'>NOT ALLOW_USER_USB_AUTH = "1"</Publish>
          <Publish Event='SetFeatureLevel' Value='feat_policy_usb_auth'>[_USB_AUTH_LVL]</Publish>
        </Control>
        <Control Id='chk_user_file_read' Type='CheckBox'
          X='20' Y='102' Width='340' Height='17'
          Property='ALLOW_USER_FILE_READ' CheckBoxValue='1'>
          <Text>Allow user to authorize blocked files for &amp;reading</Text>
          <Publish Property='_FILE_READ_LVL' Value='1'>ALLOW_USER_FILE_READ = "1"</Publish>
          <Publish Property='_FILE_READ_LVL' Value='2'>NOT ALLOW_USER_FILE_READ = "1"</Publish>
          <Publish Event='SetFeatureLevel' Value='feat_policy_file_read'>[_FILE_READ_LVL]</Publish>
        </Control>
        <Control Id='chk_user_file_write' Type='CheckBox'
          X='20' Y='124' Width='340' Height='17'
          Property='ALLOW_USER_FILE_WRITE' CheckBoxValue='1'>
          <Text>Allow user to authorize blocked files for &amp;writing</Text>
          <Publish Property='_FILE_WRITE_LVL' Value='1'>ALLOW_USER_FILE_WRITE = "1"</Publish>
          <Publish Property='_FILE_WRITE_LVL' Value='2'>NOT ALLOW_USER_FILE_WRITE = "1"</Publish>
          <Publish Event='SetFeatureLevel' Value='feat_policy_file_write'>[_FILE_WRITE_LVL]</Publish>
        </Control>
        <Control Id='Note' Type='Text' X='20' Y='155' Width='340' Height='35'
          Transparent='yes' NoPrefix='yes'>
          <Text>Note: these settings can also be passed via command line or changed after installation in the tray application.</Text>
        </Control>
        <Control Id='Next' Type='PushButton' X='236' Y='243' Width='56' Height='17'
          Default='yes' Text='&amp;Next'>
          <Publish Event='NewDialog' Value='CertInfoDlg'>1</Publish>
        </Control>
        <Control Id='Back' Type='PushButton' X='180' Y='243' Width='56' Height='17'
          Text='&amp;Back'>
          <Publish Event='NewDialog' Value='KeysasWelcomeDlg'>1</Publish>
        </Control>
        <Control Id='Cancel' Type='PushButton' X='304' Y='243' Width='56' Height='17'
          Cancel='yes' Text='Cancel'>
          <Publish Event='SpawnDialog' Value='CancelDlg'>1</Publish>
        </Control>
      </Dialog>

      <!-- Step 3 — Certificate deposit instructions + Install button -->
      <Dialog Id='CertInfoDlg' Width='370' Height='270'
        Title='Certificates — [ProductName]'>
        <Control Id='BannerBitmap' Type='Bitmap' X='0' Y='0' Width='370' Height='44'
          TabSkip='yes' Text='WixUI_Bmp_Banner'/>
        <Control Id='BannerLine' Type='Line' X='0' Y='44' Width='370' Height='0'/>
        <Control Id='BottomLine' Type='Line' X='0' Y='234' Width='370' Height='0'/>
        <Control Id='Title' Type='Text' X='15' Y='6' Width='200' Height='15'
          Transparent='yes' NoPrefix='yes'>
          <Text>{\WixUI_Font_Title}Certificates</Text>
        </Control>
        <Control Id='Description' Type='Text' X='25' Y='23' Width='300' Height='15'
          Transparent='yes' NoPrefix='yes'>
          <Text>CA certificate files required by the daemon.</Text>
        </Control>
        <Control Id='Info1' Type='Text' X='20' Y='55' Width='340' Height='25'
          Transparent='yes' NoPrefix='yes'>
          <Text>After installation, copy the four CA certificate files generated by keysas-admin into:</Text>
        </Control>
        <Control Id='CertPath' Type='Text' X='30' Y='83' Width='320' Height='15'
          Transparent='yes' NoPrefix='yes'>
          <Text>C:\ProgramData\Keysas\Firewall\</Text>
        </Control>
        <Control Id='FileLabel' Type='Text' X='20' Y='105' Width='340' Height='15'
          Transparent='yes' NoPrefix='yes'>
          <Text>Required files (as output by keysas-admin):</Text>
        </Control>
        <Control Id='File1' Type='Text' X='30' Y='123' Width='320' Height='13'
          Transparent='yes' NoPrefix='yes'>
          <Text>st-ca-cl.pem   (station CA — ED25519)</Text>
        </Control>
        <Control Id='File2' Type='Text' X='30' Y='138' Width='320' Height='13'
          Transparent='yes' NoPrefix='yes'>
          <Text>st-ca-pq.pem   (station CA — ML-DSA87)</Text>
        </Control>
        <Control Id='File3' Type='Text' X='30' Y='153' Width='320' Height='13'
          Transparent='yes' NoPrefix='yes'>
          <Text>usb-cl.pem     (USB CA — ED25519)</Text>
        </Control>
        <Control Id='File4' Type='Text' X='30' Y='168' Width='320' Height='13'
          Transparent='yes' NoPrefix='yes'>
          <Text>usb-pq.pem     (USB CA — ML-DSA87)</Text>
        </Control>
        <Control Id='Install' Type='PushButton' X='236' Y='243' Width='56' Height='17'
          Default='yes' Text='&amp;Install'>
          <Publish Event='EndDialog' Value='Return'>1</Publish>
        </Control>
        <Control Id='Back' Type='PushButton' X='180' Y='243' Width='56' Height='17'
          Text='&amp;Back'>
          <Publish Event='NewDialog' Value='PolicySettingsDlg'>1</Publish>
        </Control>
        <Control Id='Cancel' Type='PushButton' X='304' Y='243' Width='56' Height='17'
          Cancel='yes' Text='Cancel'>
          <Publish Event='SpawnDialog' Value='CancelDlg'>1</Publish>
        </Control>
      </Dialog>

      <InstallUISequence>
        <!--
          Show AFTER CostFinalize so that SetFeatureLevel changes made in the
          dialog are not overwritten by CostFinalize's feature-level recalculation.
          CostFinalize resets sub-features to their table Level (2=absent) if the
          dialog fires before it — policy DWORDs would never be written.
        -->
        <Show Dialog='KeysasWelcomeDlg' After='CostFinalize'>1</Show>
      </InstallUISequence>
    </UI>

  </Product>
</Wix>
