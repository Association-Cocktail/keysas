# ─────────────────────────────────────────────────────────────────────────────
# Keysas Firewall — MSI builder (Linux container, cross-compile to Windows)
#
# Strategy:
#   1. Cross-compile the daemon for x86_64-pc-windows-gnu (MinGW toolchain).
#   2. Package the binary into a Windows MSI using wixl (msitools), a Linux
#      implementation of WiX v3 that produces .msi files without Wine or WiX.
#
# IMPORTANT: build context must be the repository root, not this directory.
#
# Usage (from the repository root):
#   docker build \
#       -f keysas-firewall/daemon/Dockerfile.msi \
#       --output type=local,dest=./dist \
#       .
#   → dist/keysas-firewall-<version>-x64.msi
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM rust:1.88-bookworm AS builder

# MinGW cross-compiler + wixl (separate package from msitools on Debian)
# + libclang (bindgen) + cmake + nasm (liboqs/oqs-sys build)
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-mingw-w64-x86-64 \
        g++-mingw-w64-x86-64 \
        wixl \
        clang \
        libclang-dev \
        cmake \
        nasm \
    && rm -rf /var/lib/apt/lists/* \
    && wixl --version

# Register the Windows GNU target
RUN rustup target add x86_64-pc-windows-gnu

# Tell Cargo to use the MinGW linker for the Windows target
RUN mkdir -p /root/.cargo && printf \
    '[target.x86_64-pc-windows-gnu]\nlinker = "x86_64-w64-mingw32-gcc"\n' \
    >> /root/.cargo/config.toml

# Copy path dependencies, preserving the relative layout expected by Cargo.toml:
#   daemon/Cargo.toml: libmailslot  = { path = "../libmailslot"  }
#   daemon/Cargo.toml: keysas_lib   = { path = "../../keysas_lib" }
WORKDIR /src
COPY keysas_lib/                        keysas_lib/
COPY keysas-firewall/libmailslot/       keysas-firewall/libmailslot/
COPY keysas-firewall/daemon/            keysas-firewall/daemon/

# ── Cross-compile ─────────────────────────────────────────────────────────────
WORKDIR /src/keysas-firewall/daemon
RUN cargo build --release --target x86_64-pc-windows-gnu

# ── Package MSI ───────────────────────────────────────────────────────────────
RUN VERSION=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/') && \
    BIN_DIR=target/x86_64-pc-windows-gnu/release && \
    wixl \
        -D Version="${VERSION}" \
        -D BinDir="${BIN_DIR}" \
        -a x64 \
        wix/main.wxs \
        -o "keysas-firewall-${VERSION}-x64.msi" && \
    echo "MSI built: keysas-firewall-${VERSION}-x64.msi"

# ── Stage 2: export ───────────────────────────────────────────────────────────
FROM scratch AS export
COPY --from=builder /src/keysas-firewall/daemon/keysas-firewall-*.msi /
