# ─────────────────────────────────────────────────────────────────────────────
# Keysas Firewall — MSI builder (Linux container, cross-compile to Windows)
#
# Strategy:
#   1. Cross-compile the daemon for x86_64-pc-windows-gnu (MinGW toolchain).
#   2. Package daemon + minifilter driver into a Windows MSI via wixl (msitools).
#
# Prerequisites in the build context (repository root):
#   keysas-firewall/minifilter/x64/Release/KeysasMinifilter/
#     ├── KeysasMinifilter.sys   ← compiled with WDK on Windows (required)
#     └── KeysasMinifilter.cat   ← catalog / signed with WDK signtool (required)
#   The .inf is taken from the source tree.
#
# If the minifilter has not been built yet, create a placeholder to allow
# the Docker build to proceed (the resulting MSI will not load the driver):
#   mkdir -p keysas-firewall/minifilter/x64/Release/KeysasMinifilter
#   touch keysas-firewall/minifilter/x64/Release/KeysasMinifilter/KeysasMinifilter.{sys,cat}
#
# IMPORTANT: build context must be the repository root, not this directory.
#
# Usage (from the repository root):
#   docker build \
#       -f keysas-firewall/daemon/Dockerfile.msi \
#       --output type=local,dest=./dist \
#       .
#   → dist/keysas-firewall-<version>-x64.msi
# ─────────────────────────────────────────────────────────────────────────────

# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM rust:1.88-bookworm AS builder

# MinGW cross-compiler + wixl (separate package from msitools on Debian)
# + libclang (bindgen) + cmake + nasm (liboqs/oqs-sys build)
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc-mingw-w64-x86-64 \
        g++-mingw-w64-x86-64 \
        wixl \
        clang \
        libclang-dev \
        cmake \
        nasm \
    && rm -rf /var/lib/apt/lists/* \
    && wixl --version

# Register the Windows GNU target
RUN rustup target add x86_64-pc-windows-gnu

# Tell Cargo to use the MinGW linker for the Windows target
RUN mkdir -p /root/.cargo && printf \
    '[target.x86_64-pc-windows-gnu]\nlinker = "x86_64-w64-mingw32-gcc"\n' \
    >> /root/.cargo/config.toml

# ── Copy sources ──────────────────────────────────────────────────────────────
# Preserves the relative layout expected by Cargo.toml:
#   daemon/Cargo.toml: libmailslot = { path = "../libmailslot" }
#   daemon/Cargo.toml: keysas_lib  = { path = "../../keysas_lib" }
WORKDIR /src
COPY keysas_lib/                        keysas_lib/
COPY keysas-firewall/libmailslot/       keysas-firewall/libmailslot/
COPY keysas-firewall/daemon/            keysas-firewall/daemon/

# ── Copy minifilter pre-built files ───────────────────────────────────────────
# The .inf lives in the source tree; .sys and .cat must be compiled on Windows
# with the WDK and placed at the expected path before running this build.
COPY keysas-firewall/minifilter/KeysasMinifilter.inf \
     keysas-firewall/minifilter/KeysasMinifilter.inf
COPY keysas-firewall/minifilter/x64/Release/KeysasMinifilter/ \
     keysas-firewall/minifilter/x64/Release/KeysasMinifilter/

# ── Cross-compile daemon ──────────────────────────────────────────────────────
WORKDIR /src/keysas-firewall/daemon
RUN cargo build --release --target x86_64-pc-windows-gnu

# ── Package MSI ───────────────────────────────────────────────────────────────
RUN VERSION=$(grep '^version' Cargo.toml | head -1 | sed 's/.*"\(.*\)".*/\1/') && \
    BIN_DIR=target/x86_64-pc-windows-gnu/release && \
    MINIFILTER_DIR=../minifilter/x64/Release/KeysasMinifilter && \
    wixl \
        -D Version="${VERSION}" \
        -D BinDir="${BIN_DIR}" \
        -D MinifilterDir="${MINIFILTER_DIR}" \
        -a x64 \
        wix/main.wxs \
        -o "keysas-firewall-${VERSION}-x64.msi" && \
    echo "MSI built: keysas-firewall-${VERSION}-x64.msi"

# ── Stage 2: export ───────────────────────────────────────────────────────────
FROM scratch AS export
COPY --from=builder /src/keysas-firewall/daemon/keysas-firewall-*.msi /
