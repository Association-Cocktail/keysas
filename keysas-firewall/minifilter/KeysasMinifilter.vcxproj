  <!--
    WDKKmInclude / WDKSharedInclude / DDK_LIB_PATH are injected by the CI
    workflow when the WDK is installed as a VS2022 component (not standalone):
    the WindowsKernelModeDriver10.0 toolset is present but does not wire up
    include/lib paths automatically in that install mode.
    Passing these as /p: on the msbuild command line overrides these properties.
    The Condition guards local developer builds where the toolset handles paths.
  -->
  <ItemDefinitionGroup Condition="'$(WDKKmInclude)' != ''">
    <ClCompile>
      <AdditionalIncludeDirectories>$(WDKKmInclude);$(WDKSharedInclude);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- Architecture macros required by ntdef.h / wdm.h — not injected by the
           WindowsKernelModeDriver10.0 toolset in VS2022 component install mode. -->
      <PreprocessorDefinitions Condition="'$(Platform)' == 'x64'">_AMD64_;_WIN64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Platform)' == 'ARM64'">_ARM64_;_WIN64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <!-- Point the linker at the NuGet WDK lib directory so it can resolve
           ntoskrnl.lib, hal.lib, wmilib.lib and the other kernel imports that
           the toolset normally provides via its built-in lib path. -->
      <AdditionalLibraryDirectories>$(DDK_LIB_PATH);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
    <Link>
      <AdditionalDependencies>$(DDK_LIB_PATH)fltMgr.lib;$(DDK_LIB_PATH)ksecdd.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
