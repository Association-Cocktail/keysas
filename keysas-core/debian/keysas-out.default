# Keysas-out configuration file
# This file is part of keysas
#
# Socket_out path
# You should not touch this parameter.
# Pay attention to add a slash at the end
SOCKET_OUT=socket_out

# Path where incoming files will be deposited
# You should not touch this parameter.
# Pay attention to add a slash at the end
SAS_OUT=/var/local/out/

# Génération des fichiers de rapport .krp
# Valeurs possibles :
#   always    — toujours générer le .krp
#   never     — ne jamais générer de .krp
#   pass_only — .krp uniquement pour les fichiers acceptés
#   fail_only — .krp uniquement pour les fichiers rejetés (défaut)
KRP_MODE=always

# Idle timeout: delete all files in OUT if no transfer has occurred for this many minutes.
# This prevents sensitive files from accumulating unattended on the device.
# Set to 0 to disable.
OUT_IDLE_TIMEOUT=30

