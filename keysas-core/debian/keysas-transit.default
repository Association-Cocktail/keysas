# Keysas-transit configuration file
# This file is part of keysas.
#
# Socket_in path
# You should not touch this parameter.
# Pay attention to add a slash at the end
SOCKET_IN=socket_in

# Socket_out path
# You should not touch this parameter.
# Pay attention to add a slash at the end
SOCKET_OUT=socket_out

# Max file size to be transfered
# This parameter must be consistent
# with StreamMaxLength (clamd.conf).
MAX_SIZE=500000000

# Path to Yara rules (don't forget to add index.yar)
RULES=/usr/share/keysas/rules/index.yar

# Yara max file size to scan
# The bigger it is, the longer it takes to scan a file !
# Default is 50Mo (50000000 bytes)
YARA_MAXFILESIZE=50000000

# Yara timeout when scannning files
YARA_TIMEOUT=1000

# Tells if keysas should remove the file if Yara matched at least one rule
YARA_CLEAN=true

# Clamd server IP 
# Note that if you modify this address, you also
# have to edit the following file 
# /etc/systemd/system/keysas-in.service.d/keysas-in.conf
# to allow sockets via systemd.
# See https://keysas.fr/configuration.html#systemd
# for more information.
CLAMAV_IP=127.0.0.1

# Clamd server port
CLAMAV_PORT=3310

# Set here a whitelist (comma separated) of allowed file types.
# Types with a binary magic number are verified against the file content (not just extension).
# ZIP-based formats (jar, war, docx, xlsx, pptx, epub, odt…) are verified as ZIP magic + extension.
# Plain text files (sh, yml, md, jnlp, tf, json, xml, py, csv…) pass automatically
# via UTF-8/null-byte heuristic — no need to list them here.
# Archives (zip, tar, gz, bz2, xz, tgz) are content-scanned by keysas-analyze:
#   encrypted entries and entries containing executables are blocked.
# See https://keysas.fr/administration.html#keysas-transit for more information.
ALLOWED_TYPES="jpg,png,gif,bmp,webp,tiff,mp4,mkv,avi,wmv,mpg,mov,flv,mp3,wav,ogg,flac,m4a,pdf,epub,mobi,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,jar,war,ear,zip,tar,gz,bz2,xz,tgz,iso,kdbx"

# Socket for keysas-analyze specialized analysis (leave empty to disable)
SOCKET_ANALYZE=socket_analyze

# VirusTotal integration (optional)
# Leave VT_API_KEY empty to disable VirusTotal lookups entirely.
# Only SHA256 hashes are sent — files are never uploaded.
# VT_API_KEY         → VirusTotal API key
# VT_API_URL         → base URL for the VT files API (change for on-prem/proxy deployments)
# VT_FAIL_OPEN       → true = pass the file if VT is unreachable; false = block
# VT_BLOCK_THRESHOLD → minimum number of malicious detections to block a file
# VT_TIMEOUT_MS      → HTTP timeout in milliseconds for VT API calls
# VT_PROBE_HOST      → host:port used to check internet connectivity before each VT call
# VT_PROBE_TIMEOUT_MS→ timeout in ms for the connectivity probe
# VT_CACHE_TTL_SECS  → how long (in seconds) VT results are cached in memory
VT_API_KEY=
VT_API_URL=https://www.virustotal.com/api/v3/files
VT_FAIL_OPEN=true
VT_BLOCK_THRESHOLD=3
VT_TIMEOUT_MS=3000
VT_PROBE_HOST=8.8.8.8:53
VT_PROBE_TIMEOUT_MS=2000
VT_CACHE_TTL_SECS=3600
